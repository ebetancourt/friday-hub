# Copy to .env. Defaults match docker-compose.yml.
DATABASE_URL=postgres://friday_app:friday_app@localhost:5460/friday   # app role, RLS applies
MIGRATION_DATABASE_URL=postgres://friday:friday@localhost:5460/friday  # owner role, migrations only
REDIS_URL=redis://localhost:6390
PORT=3060
HOST=127.0.0.1
PUBLIC_URL=http://localhost:5173

# 32 random bytes, base64: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
SECRETS_KEY=
SECRETS_KEY_VERSION=1

# OAuth clients. Create new ones for Friday Hub; never share them with another deployment.
FRIDAY_GOOGLE_CLIENT_ID=
FRIDAY_GOOGLE_CLIENT_SECRET=
FRIDAY_TODOIST_CLIENT_ID=
FRIDAY_TODOIST_CLIENT_SECRET=
