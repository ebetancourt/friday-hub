{
  "name": "friday-hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @friday-hub/server --filter @friday-hub/web dev",
    "gen": "pnpm --filter @friday-hub/server openapi && pnpm --filter @friday-hub/client gen",
    "db:generate": "pnpm --filter @friday-hub/db generate",
    "db:migrate": "pnpm --filter @friday-hub/db migrate",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "storybook": "pnpm --filter @friday-hub/ui storybook"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
